# این فایل را به .env کپی کنید و مقادیر را پر کنید.
# cp .env.example .env

# انتخاب مدل: demo | gemini | ollama
LLM_PROVIDER=demo

# کلید رایگان Gemini را از https://aistudio.google.com/apikey بگیرید
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# تنظیمات Ollama محلی (اگر LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# تعداد قطعات بازیابی‌شده و درصد مالیات
TOP_K=4
VAT_PERCENT=9
